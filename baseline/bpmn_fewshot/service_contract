Smart Contract in Solidity
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract ServiceContract {
    address public provider;
    address public client;
    string public serviceType;
    uint256 public serviceFee;
    uint256 public completionDate;
    uint256 public confirmDate;
    bool public depositPaid;
    bool public serviceCompleted;
    bool public confirmed;
    bool public correctionsMade;

    event ServiceStarted(address client, uint256 depositAmount);
    event ServiceCompleted(address provider);
    event IssueRaised(address client);
    event CorrectionMade(address provider);
    event PaymentReleased(address provider, uint256 paymentAmount);
    event DepositRefunded(address client, uint256 refundAmount);

    modifier onlyClient() {
        require(msg.sender == client, "Only the client can call this function.");
        _;
    }

    modifier onlyProvider() {
        require(msg.sender == provider, "Only the provider can call this function.");
        _;
    }

    constructor(
        address _provider,
        address _client,
        string memory _serviceType,
        uint256 _serviceFee,
        uint256 _completionDate,
        uint256 _confirmDate
    ) {
        provider = _provider;
        client = _client;
        serviceType = _serviceType;
        serviceFee = _serviceFee;
        completionDate = _completionDate;
        confirmDate = _confirmDate;
        depositPaid = false;
        serviceCompleted = false;
        confirmed = false;
        correctionsMade = false;
    }

    function payDeposit() public payable onlyClient {
        require(!depositPaid, "Deposit has already been paid.");
        require(msg.value >= (serviceFee * 3) / 10, "Insufficient deposit amount.");

        depositPaid = true;
        payable(provider).transfer((serviceFee * 3) / 10);
        emit ServiceStarted(client, (serviceFee * 3) / 10);
    }

    function deliverService() public onlyProvider {
        require(depositPaid, "Deposit must be paid before service starts.");
        require(block.timestamp <= completionDate, "Service deadline has passed.");

        serviceCompleted = true;
        emit ServiceCompleted(provider);
    }

    function confirmCompletion() public onlyClient {
        require(serviceCompleted, "Service has not been completed.");
        confirmed = true;
        emit ServiceCompleted(provider);
    }

    function makePayment() public payable onlyClient {
        require(confirmed, "Service must be confirmed before final payment.");
        require(msg.value >= (serviceFee * 7) / 10, "Insufficient payment amount.");

        payable(provider).transfer((serviceFee * 7) / 10);
        emit PaymentReleased(provider, (serviceFee * 7) / 10);
    }

    function requestRefund() public onlyClient {
        require(block.timestamp > completionDate, "Service deadline has not passed.");
        require(!serviceCompleted, "Service has already been completed.");

        depositPaid = false;
        payable(client).transfer((serviceFee * 3) / 10);
        emit DepositRefunded(client, (serviceFee * 3) / 10);
    }

    function correctIssues() public onlyProvider {
        require(block.timestamp <= confirmDate, "Correction period has expired.");
        require(!confirmed, "Service has already been confirmed.");

        correctionsMade = true;
        emit CorrectionMade(provider);
    }

    receive() external payable {}
}
